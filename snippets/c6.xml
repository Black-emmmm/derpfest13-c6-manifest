<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!--
    C6 (Unisoc UD710 / CB-C6-STU) 的 DerpFest 13 定制补丁。

    只覆盖两个上游项目，其余 1154 个项目仍走 AOSP 清华镜像和 DerpFest 官方，
    不需要 fork 整棵树。必须在本文件之前先 include 完上游 snippets，
    否则 remove-project 找不到要移除的项目。
  -->
  <remote name="c6" fetch="https://github.com/Black-emmmm" />

  <!--
    AOSP Bluetooth，三处改动：
      1) system/stack/a2dp/a2dp_vendor_ldac.cc
         默认配置锁 96000Hz / 24bit / STEREO
      2) system/stack/a2dp/a2dp_vendor_ldac_encoder.cc
         质量档 ABR 自适应 -> MID(660kbps 固定)
      3) system/gd/stack_manager.cc
         Gd stack 启动超时 3s -> 15s，消除蓝牙进程重启时的连环 ASSERT
  -->
  <remove-project name="platform/packages/modules/Bluetooth" />
  <project path="packages/modules/Bluetooth"
           name="platform_packages_modules_Bluetooth"
           remote="c6"
           revision="derp13"
           groups="pdk" />

  <!--
    DerpFest vendor 配置，改动：
      bootanimation/bootanimation.zip  竖屏面板横构图启动动画
      build/soong/Android.bp           移除 derp_generator
      config/common.mk                 产品配置
      config/telephony.mk              电话配置
  -->
  <remove-project name="vendor_derp" />
  <project path="vendor/derp"
           name="vendor_derp"
           remote="c6"
           revision="derp13" />
</manifest>
